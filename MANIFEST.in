include README.md
include LICENSE
include pyproject.toml
recursive-include docs *.md
recursive-include tests *.py
recursive-exclude tests __pycache__ *
# The default YARA ruleset is runtime data, not code: without it the YARA adapter
# is inert on a pip install, which is the defect the 0.6.4 audit flagged.
include src/grim/feeds/default_rules.yar
